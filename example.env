KASPANET=testnet10
TURSO_DATABASE_URL=libsql://<your-db>.turso.io
TURSO_AUTH_TOKEN=<your-token>

# Wallet auth is fail-closed: the API refuses to boot without AUTH_SECRET.
AUTH_SECRET=<32+ random characters>
# The origin the SPA is served from — the signed claim's URI must match it.
AUTH_ORIGIN=http://localhost:3000
# Optional session lifetime for the auth JWT (default 900s / 15 min).
AUTH_SESSION_TTL_MS=900000
