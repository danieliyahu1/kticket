{
  "name": "@kticket/kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Covenant WASM kit — on-chain ticket rules, tx building and covenant state decoding. Shared by api / web / door.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "artifacts",
    "contracts",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/silverc.mjs",
    "check:contracts": "node scripts/silverc.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
