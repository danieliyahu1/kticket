pragma silverscript ^0.1.0;

// Deliberately malformed: the buy entrypoint references an unknown guard.
contract Ticket(byte[32] event_id, int index, int price, byte[] org_spk, template burn_tmpl) {
    int      phase = 0;
    byte[32] owner = ZERO;

    #[covenant(binding = auth, from = 1, to = 1)]
    function buy(State prev, byte[32] buyer_pkh) : (State) {
        require(prev.phase == 0);
        require(prev.phase == 99);
        return({ phase: 1, owner: buyer_pkh });
    }
}
