pragma silverscript ^0.1.0;

// Event covenant (HLD v0.22 §2.1, forge-style KCC20 fork).
//
// One event covenant holds `amount = capacity` (remaining tickets). Tickets are
// minted on sale by `mint`: the event covenant splits off one ticket covenant
// (amount = 1, owner = buyer) and decrements its own amount. Rules freeze at
// deploy (FR-7); fixed supply (isMinter = false) — no minting beyond capacity.
//
// Price (+ event meta) lives in the constants, visible to both sides; the
// covenant does not enforce the payment amount.

contract Event(byte[32] event_id, int price, byte[] org_spk, template burn_tmpl) {
    byte[32] owner = ZERO;   // organizer identifier (set at deploy)
    byte     identifier_type = 0;
    int      amount = 0;     // remaining tickets; set to capacity at deploy
    bool     is_minter = false;

    #[covenant(binding = auth, from = 1, to = 2)]
    function mint(State prev, byte[32] buyer_pkh) : (State) {
        require(checkSigFromStack(prev.owner));           // organizer authorizes the sale
        require(prev.amount > 0);                         // oversell rejected (FR-8/27)
        require(OpAuthOutputCount(this.activeInputIndex) == 2); // ticket + remaining event
        if (price > 0) require(existsOutput(org_spk, price));   // payout in same tx
        return({ amount: 1, owner: buyer_pkh });          // the minted ticket
    }

    #[covenant(binding = auth, from = 1, to = 1)]
    function transfer(State prev, byte[32] new_owner) : (State) {
        require(checkSigFromStack(prev.owner));
        require(prev.amount == 1);                        // tickets only
        return({ amount: prev.amount, owner: new_owner });
    }

    #[covenant(binding = auth, from = 1, to = 1)]
    function use(State prev) : (State) {
        require(checkSigFromStack(prev.owner));
        require(prev.amount == 1);                        // tickets only
        int o = OpAuthOutputIdx(this.activeInputIndex, 0);
        validateOutputStateWithTemplate(o, burn_tmpl);    // successor IS the burn-owner
        return(NONE);                                     // ticket consumed
    }
}
