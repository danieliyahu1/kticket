pragma silverscript ^0.1.0;

// Burn-owner covenant (HLD v0.22 §2.1). Unspendable: no entrypoints -> no
// valid spend -> permanent. Each handover spends the attendee's ticket
// (amount = 1) into this covenant, so the ticket — dust included — is consumed
// and gone from the wallet at the door.
contract Burn(byte[32] authorizing_txid) {
    int count = 1;
}
